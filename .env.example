# ── Huizenjacht – Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Search criteria ───────────────────────────────────────────────────────────
SEARCH_REGION=Vlaamse Ardennen
SEARCH_POSTAL_CODES=9600,9620,9630,9660,9680,9688,9690,9700,9750,9770,9790
MAX_PRICE=600000
MIN_BEDROOMS=3
MIN_LAND_AREA=5000
KEYWORDS=landelijk,hoeve,boerderij,weiland,stal,schuur,B&B,gastenverblijf,agrarisch

# ── Notification ──────────────────────────────────────────────────────────────
NOTIFICATION_EMAIL=jonathan.dhaene@gmail.com

# SMTP settings (e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Huizenjacht <your-sender@gmail.com>

# ── OpenAI (for AI enrichment) ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ── GitHub Models (free fallback when OPENAI_API_KEY is empty) ────────────────
# Create a fine-grained PAT with the "Models" permission and paste it here, or
# rely on the GITHUB_TOKEN that GitHub Actions exposes automatically.
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

# ── Cache ─────────────────────────────────────────────────────────────────────
# Directory to store the seen-properties cache and schedule state
CACHE_DIR=.cache

# ── Scheduling ────────────────────────────────────────────────────────────────
# Time of day to run the daily scan (24h HH:MM, local time)
DAILY_RUN_TIME=07:00

# ── Collaborative web app ─────────────────────────────────────────────────────
# Display names for the two partners (shown in the mobile app and match emails)
USER1_NAME=Jonathan
USER2_NAME=

# GitHub repo coordinates (used by the Actions workflow — usually auto-set)
GITHUB_OWNER=jonathandhaene
GITHUB_REPO=Huizenjacht
GITHUB_BRANCH=main

# ── Optional: Facebook / social media ────────────────────────────────────────
# Leave blank to disable social-media scraping
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
